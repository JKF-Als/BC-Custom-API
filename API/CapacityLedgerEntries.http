@baseUrl = https://api.businesscentral.dynamics.com/v2.0/67c998ad-883d-4441-8709-30a73ec72cb6/Robex_test/api/jkf/integration/v1.0/companies(45342618-9928-ed11-97e8-000d3a652983)
@token = REPLACE_WITH_ACCESS_TOKEN

### All capacity ledger entries in the selected company. No body required.
# Assign permission set JKF CAPACITY LEDGER to the integration user.
# Install the extension; no Web Services registration is required.
# Follow each @odata.nextLink until absent to retrieve all pages.
GET {{baseUrl}}/capacityLedgerEntries
Authorization: Bearer {{token}}
Accept: application/json

### Optional: return only the four requested business fields.
GET {{baseUrl}}/capacityLedgerEntries?$select=documentNo,number,quantity,operationNo
Authorization: Bearer {{token}}
Accept: application/json
